#!/usr/bin/env python3
"""Launcher: csvview [file.csv]  (csvview.pyw is the same launcher without a console window on Windows)"""
import os
import sys

root = os.path.dirname(os.path.realpath(__file__))
# Prefer the repo's .venv (it adds the assistant's packages: anthropic, duckdb)
venvPython = os.path.join(root, '.venv', 'Scripts' if os.name == 'nt' else 'bin', ('pythonw.exe' if False else 'python.exe') if os.name == 'nt' else 'python')
if os.path.exists(venvPython) and os.path.realpath(sys.prefix) != os.path.realpath(os.path.join(root, '.venv')):
    os.execv(venvPython, [venvPython, os.path.realpath(__file__)] + sys.argv[1:])
sys.path.insert(0, root)
from csvviewer.app import main  # noqa: E402

main()
